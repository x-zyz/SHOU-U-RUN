<Window
    x:Class="ShouURun.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls"
    Title="SHOU U RUN">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="16,8" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE707;" FontSize="17" />
                    <TextBlock Text="SHOU U RUN" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" x:Name="NavigationButtons" IsHitTestVisible="False">
                    <ToggleButton Content="路线" Tag="route" IsChecked="True" Click="OnNavigate" />
                    <ToggleButton Content="参数" Tag="parameters" Click="OnNavigate" />
                    <ToggleButton Content="真实跑步" Tag="real" Click="OnNavigate" />
                    <ToggleButton Content="导出与登录" Tag="output" Click="OnNavigate" />
                </StackPanel>
            </Grid>
        </Border>
        <ui:WebView2 x:Name="Browser" Grid.Row="1" Visibility="Collapsed" />
        <StackPanel x:Name="Startup" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420" Padding="16">
            <ProgressRing x:Name="Loading" IsActive="True" Width="34" Height="34" />
            <TextBlock x:Name="StartupMessage" Text="正在打开路线工作台…" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
